# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# GitHub Actions 에서는 같은 이름으로 Repository secrets 에 등록합니다.

# --- AI 요약 (Gemini) ---
# https://aistudio.google.com/apikey 에서 무료 발급.
# ⚠ 무료 티어는 모델당 하루 20회. 이 시스템은 정상 동작 시 하루 6회를 씁니다.
#   로컬 테스트를 반복하면 한도를 다 쓰므로 테스트는 --no-ai 로 하세요.
# 비워두면 요약 없이 헤드라인만 나갑니다(나머지는 정상 동작).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# 구글이 모델을 자주 교체합니다. 이름이 막히면 코드가 대안 모델로 자동 폴백합니다.
GEMINI_MODEL=gemini-3.6-flash

# --- Google OAuth (scripts/authorize.py 가 발급) ---
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
GOOGLE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN_HERE

# 문서를 모아둘 폴더 이름. 앱이 첫 실행 때 직접 만들고 이후 재사용합니다.
DRIVE_FOLDER_NAME=뉴스 다이제스트

# (고급) 이미 있는 폴더를 쓰려면 ID 를 넣으세요. 단 drive.file 스코프는
# "앱이 만든 파일"만 볼 수 있어서, 직접 만든 폴더 ID 는 404 가 날 수 있습니다.
DRIVE_FOLDER_ID=

# --- 메일 발송 (Gmail 앱 비밀번호) ---
# https://myaccount.google.com/apppasswords 에서 16자리 발급 (2단계 인증 필요)
GMAIL_ADDRESS=example@gmail.com
GMAIL_APP_PASSWORD=example-app-password
# 받는 사람. 비우면 GMAIL_ADDRESS 로 보냄
MAIL_TO=
